rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo usuarios autenticados pueden leer y escribir
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Excepción: reservas — cualquiera puede CREAR (formulario público)
    match /reservations/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Excepción: chat_sessions y chat_messages — cualquiera puede CREAR y LEER la propia sesión
    match /chat_sessions/{sessionId} {
      allow create: if true;
      allow read, update: if request.auth != null || resource.data.guest_email == request.auth.token.email;
      allow delete: if request.auth != null;
    }

    match /chat_messages/{messageId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
